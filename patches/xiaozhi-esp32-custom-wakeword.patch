diff --git a/scripts/build.py b/scripts/build.py
index f3452ef..46c87a0 100755
--- a/scripts/build.py
+++ b/scripts/build.py
@@ -1650,6 +1650,31 @@ def build_board(
             sdkconfig_append,
             user_options,
         )
+
+        # 板级显式写死的唤醒词配置优先于自动生成项（用于 MultiNet 自定义唤醒词，
+        # 例如 CONFIG_USE_CUSTOM_WAKE_WORD=y + CONFIG_CUSTOM_WAKE_WORD="xin xin tong xue"）
+        _board_append = build.get("sdkconfig_append", []) or []
+        _wake_exact = {
+            "CONFIG_USE_CUSTOM_WAKE_WORD",
+            "CONFIG_USE_AFE_WAKE_WORD",
+            "CONFIG_USE_ESP_WAKE_WORD",
+            "CONFIG_WAKE_WORD_DISABLED",
+        }
+        _board_wake = [
+            item for item in _board_append
+            if isinstance(item, str) and (
+                item.split("=", 1)[0] in _wake_exact
+                or item.split("=", 1)[0].startswith("CONFIG_CUSTOM_WAKE_WORD")
+            )
+        ]
+        if _board_wake:
+            sdkconfig_append = _merge_sdkconfig_options(sdkconfig_append, _board_wake)
+            print(f"board-level wake word override: {_board_wake}")
+            # 板级接管唤醒词后，CLI 的 --wake-word 校验必然对不上，跳过它
+            validation_symbols = [
+                entry for entry in validation_symbols if entry[1] != "--wake-word"
+            ]
+
         sdkconfig_append = _apply_auto_selects(sdkconfig_append)
 
         print("-" * 80)
