# 复制成 kidbox/.env 后即可生效（不用改代码）
# 有 key 就用 DeepSeek，没有 key 自动用离线 mock，流程照样能跑

# ---------- 大脑 ----------
# auto = 有 key 用 DeepSeek，没 key 用离线规则；deepseek = 强制用大模型；mock = 强制离线
KIDBOX_BRAIN=auto
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE=https://api.deepseek.com

# ---------- 播放 / 语音 ----------
# auto = 有 ffplay 就出声；null = 静默只跑逻辑（适合在别人电脑上验收）
KIDBOX_PLAYER=auto
# 1 = 开启 edge-tts 语音合成；0 = 只打印文字
KIDBOX_TTS=1

# ---------- 语音识别（只有麦克风模式才用）----------
KIDBOX_ASR=siliconflow
SILICONFLOW_API_KEY=
SILICONFLOW_ASR_MODEL=FunAudioLLM/SenseVoiceSmall
KIDBOX_ASR_LANG=zh

# ---------- 科普问答的联网搜索 ----------
# none = 不联网（会明确说"我不太确定"）；bocha = 博查；searxng = 自建
KIDBOX_SEARCH=none
BOCHA_API_KEY=
KIDBOX_SEARXNG=http://127.0.0.1:8080

# ---------- 孩子相关参数 ----------
KIDBOX_LEVEL=L1
KIDBOX_MAX_VOLUME=78
KIDBOX_WAKE_THRESHOLD=0.55
KIDBOX_SESSION_MAX=25
